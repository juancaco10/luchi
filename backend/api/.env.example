# Plantilla de configuración del backend PHP.
# Copiar a backend/api/.env (o a config/database.php según corresponda)
# y rellenar con las credenciales reales. Ese archivo NUNCA se commitea
# (ver .gitignore: backend/api/config/database.php).

DB_HOST=localhost
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=

APP_ENV=production
APP_DEBUG=false

JWT_SECRET=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET_64_CHARS

# Client ID de tipo "Web" del google-services.json (oauth_client con
# client_type=3). Es contra el que se valida el campo `aud` de cualquier
# idToken de Google que llegue a /auth/google — sin esta comprobación,
# un token válido emitido para OTRA app cualquiera de Google sería
# aceptado. Android también usa este mismo client_id como serverClientId.
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# Feed comunitario (GET /sightings). Ver docs/PRIVACY.md — la comunidad se
# considera activa y segura bajo las 3 condiciones documentadas ahí. Sin
# esto en `true`, GET /sightings responde 403 sin importar la app cliente.
PUBLIC_SIGHTINGS_ENABLED=true

# Copy this file to android/key.properties (which is gitignored) and fill in
# your real release keystore values. Generate a keystore with:
#
#   keytool -genkey -v -keystore ~/guardianes-release.jks -keyalg RSA \
#       -keysize 2048 -validity 10000 -alias guardianes
#
# Keep the keystore file and these passwords out of version control and out
# of chat/screenshots — losing this keystore means you can never publish an
# update to the same app listing again.

storePassword=CHANGE_ME
keyPassword=CHANGE_ME
keyAlias=guardianes
storeFile=C:/path/to/guardianes-release.jks

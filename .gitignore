# Miscellaneous
# Carpeta de trabajo personal (capturas, generaciones de IA) — no son
# assets de la app.
assets/images/mis cosas/
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Secrets / local config — never commit real values
.env
backend/api/.env
scripts/run_prod.sh
backend/api/config/database.php

# Fotos subidas por usuarios — no son assets del repo, y son datos de
# menores. La carpeta y su .htaccess (bloquea ejecución de scripts) sí se
# versionan; su contenido, no.
backend/api/uploads/sightings/*
!backend/api/uploads/sightings/.gitkeep

android/local.properties
android/key.properties
*.jks
*.keystore
key.properties
ios/Runner/GoogleService-Info.plist
android/app/google-services.json
